{
	"info": {
		"_postman_id": "7c98b02d-79e4-44bb-8d74-5163b573f947",
		"name": "Masiakina SOAP",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "18648574"
	},
	"item": [
		{
			"name": "Is Valid ISBN13 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const cheerio = require('cheerio');",
							"const $ = cheerio.load(pm.response.text(), ",
							"{xmlMode: true});",
							"",
							"const res = $(\"m\\\\:IsValidISBN13Result\").text();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is less than 300ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(300);",
							"});",
							"",
							"pm.test(\"Response body is not empty\", function () {",
							"    pm.expect(pm.response.text()).to.not.be.empty;",
							"});",
							"",
							"pm.test(\"Response contains correct result\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"<m:IsValidISBN13Result>true</m:IsValidISBN13Result>\");",
							"});",
							"",
							"pm.test(\"Content-Type is XML\", function () {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\");",
							"});",
							"",
							"pm.test(\"ISBN13 is valid\", function () {",
							"    pm.expect(res).to.eql(\"true\");",
							"});",
							"",
							"pm.test(\"SOAP Envelope exists\", function () {",
							"    pm.expect($(\"soap\\\\:Envelope\").length).to.be.above(0);",
							"});",
							"",
							"pm.test(\"SOAP Body exists\", function () {",
							"    pm.expect($(\"soap\\\\:Body\")[0]).to.exist;",
							"});",
							"",
							"pm.test(\"SOAP namespace is present\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"xmlns:soap\");",
							"});",
							"",
							"pm.test(\"ISBN namespace is present\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"xmlns:m=\\\"http://webservices.daehosting.com/ISBN\\\"\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-617-17-0955-3</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				},
				"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
			},
			"response": []
		},
